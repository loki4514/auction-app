generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  account_id              String        @id @default(uuid()) @db.VarChar(50)
  company_name            String        @db.VarChar(100)
  created_at              DateTime      @default(now())
  updated_at             DateTime      @updatedAt  
  current_plan_id         String?
  account_status          AccountStatus  @default(pending)
  is_used_free_plan       Boolean       @default(false)
  account_type            AccountType   @default(bidder)

  // Location & Contact
  email                   String?       @unique
  phone_number            String?       @db.VarChar(20)
  country                 String?       @db.VarChar(100)
  country_code            String?       @db.VarChar(5)
  city                    String?       @db.VarChar(100)
  state                   String?       @db.VarChar(100)
  street_address          String?       @db.VarChar(255)
  zip_code                String?       @db.VarChar(20)

  // Plan Relationship
  current_plan    plan?     @relation(fields: [current_plan_id], references: [plan_id])
  users                   users[]
  auctions                auction[]
  payments                payment[]
  subscriptions           user_subscription[]
  user_addons             user_addon[]

  

  @@map("accounts")
}

enum AccountType {
  bidder
  auctioneer
}

enum AccountStatus {
  pending
  verified
  disabled
  deleted
  suspended
  banned
}


model users {
  user_id                String        @id @default(uuid()) @db.VarChar(50)
  account_id             String
  email                  String        @unique @db.VarChar(100)
  password_hash          String        @db.VarChar(225)
  first_name             String        @default("Unknown") @db.VarChar(100)
  last_name              String        @db.VarChar(100)
  user_role              UserRole      @default(bidder)
  user_status             UserStatus   @default(pending) //  New field here
  profile_image_url      String?
  date_of_birth          DateTime?
  phone_number           String?       @db.VarChar(15)

  // Auth Tracking
  verification_token      String?       @db.VarChar(255)
  verification_expires_at DateTime?
  last_login              DateTime?
  failed_login_at         DateTime?
  failed_login_attempts   Int           @default(0)
  last_failed_login_ip    String?       @db.VarChar(45)
  current_login_ip        String?       @db.VarChar(45)
  previous_login_ip       String?       @db.VarChar(45)
  last_password_reset_at  DateTime?

  // Relations
  account                accounts      @relation(fields: [account_id], references: [account_id])
  payments               payment[]
  auth_history         user_auth_history[]

  created_at             DateTime      @default(now())           
  updated_at             DateTime      @updatedAt  

  @@map("users")
}

enum UserStatus {
  pending
  verified
  active
  inactive
}


model user_auth_history {
  id                      String         @id @default(uuid()) @db.VarChar(50)
  user_id                 String
  event_type              AuthEventType
  event_description       String?        @db.VarChar(255)

  // Network & Device Info
  ip_address              String?        @db.VarChar(45) // IPv4/IPv6
  user_agent              String?        @db.VarChar(255)
  browser                 String?        @db.VarChar(100)
  device_type             String?        @db.VarChar(50) // desktop, mobile, tablet
  location_city           String?        @db.VarChar(100)
  location_region         String?        @db.VarChar(100)
  location_country        String?        @db.VarChar(100)
  location_latitude       Float?
  location_longitude      Float?

  // Optional event-specific fields
  verification_token      String?        @db.VarChar(255)
  verification_expires_at DateTime?
  failed_login_attempts   Int?           @default(0)

  // Metadata
  created_at              DateTime       @default(now())

  // Relation
  user                    users          @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([ip_address])
  @@map("user_auth_history")
}


enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  LOGOUT
}


model password_reset_tokens {
  id         String   @id @default(dbgenerated("\"substring\"(md5((random())::text), 1, 12)")) @db.VarChar(12)
  email      String
  token      String
  created_at DateTime @default(now())
  expires_at DateTime
  is_used    Boolean  @default(false)
  updated_at DateTime @updatedAt

  @@map("password_reset_tokens")
}

model plan {
  plan_id                String              @id @default(uuid())
  name                   String              @unique
  price_usd              Float
  price_inr              Float
  price_eur              Float
  auctions_per_month     Int
  max_hosts              Int
  max_bidders            Int
  storage_limit_gb       Float
  extra_features         String?
  max_live_auctions      Int
  max_timed_auctions     Int
  timed_auction_duration Int
  max_images_per_auction Int                 @default(5)
  max_videos_per_auction Int                 @default(1)
  
  // Relations
  accounts               accounts[]
  payments               payment[]
  addons                 plan_addon[]
  subscriptions          user_subscription[]

  @@map("plan")
}

model addon {
  addon_id       String       @id @default(uuid())
  name           String
  description    String?
  base_price_usd Float
  base_price_inr Float
  base_price_eur Float
  unit           String
  payments       payment[]
  plan_addons    plan_addon[]
  user_addons    user_addon[]

  @@map("addon")
}


model plan_addon {
  plan_addon_id String   @id @default(uuid())
  plan_id       String
  addon_id      String
  created_at    DateTime @default(now())
  addon         addon    @relation(fields: [addon_id], references: [addon_id])
  plan          plan     @relation(fields: [plan_id], references: [plan_id])

  @@map("plan_addon")
}


model user_addon {
  user_addon_id String   @id @default(uuid())
  account_id    String
  user_id       String
  addon_id      String
  quantity      Int
  total_price   Float
  currency      currency
  purchased_at  DateTime @default(now())

  addon   addon    @relation(fields: [addon_id], references: [addon_id])
  account accounts @relation(fields: [account_id], references: [account_id])

  @@map("user_addon")
}

model user_subscription {
  subscription_id String              @id @default(uuid())
  account_id      String              // ✅ Renamed from user_id
  plan_id         String
  user_id         String
  price_paid      Float
  currency        currency
  status          subscription_status
  start_date      DateTime            @default(now())
  end_date        DateTime?

  plan    plan     @relation(fields: [plan_id], references: [plan_id])
  account accounts @relation(fields: [account_id], references: [account_id]) // ✅ Updated

  @@map("user_subscription")
}


model payment {
  payment_id     String         @id @default(uuid())
  user_id        String
  account_id     String         // ✅ Newly added
  plan_id        String?
  addon_id       String?
  amount         Float
  currency       currency
  payment_method payment_method @default(cashfree)
  status         payment_status
  transaction_id String         @unique
  created_at     DateTime       @default(now())

  // 🔗 Relations
  addon          addon?         @relation(fields: [addon_id], references: [addon_id])
  plan           plan?          @relation(fields: [plan_id], references: [plan_id])
  user           users          @relation(fields: [user_id], references: [user_id])        // ✅ Changed from accounts
  account        accounts       @relation(fields: [account_id], references: [account_id])  // ✅ New relation

  @@map("payment")
}

model auction {
  auction_id             String          @id
  auction_name           String
  auction_product_type   product_type[]
  auction_details        String?
  max_participants       Int?
  min_next_bid_increment Float
  initial_bid_amount     Float
  currency               currency
  auction_start_time     DateTime
  auction_end_time       DateTime?
  status                 auction_status  @default(upcoming)
  auctioneer_id          String
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  auction_type           auction_type
  rejection_reason       String?
  rejection_status       Boolean?        @default(false)
  user_id                String
  auctioneer             accounts        @relation(fields: [auctioneer_id], references: [account_id])
  files                  auction_file[]
  images                 auction_image[]

  @@map("auction")
}

model auction_image {
  image_id    String   @id @default(uuid())
  auction_id  String
  image_url   String
  uploaded_at DateTime @default(now())
  auction     auction  @relation(fields: [auction_id], references: [auction_id], onDelete: Cascade)

  @@map("auction_image")
}

model auction_file {
  file_id     String   @id @default(uuid())
  auction_id  String
  file_url    String
  file_type   String
  uploaded_at DateTime @default(now())
  auction     auction  @relation(fields: [auction_id], references: [auction_id])

  @@map("auction_file")
}

enum UserRole {
  bidder
  auctioneer
  admin
}



enum currency {
  INR
  USD
  EUR
}

enum subscription_status {
  active
  expired
  canceled
}

enum payment_status {
  pending
  completed
  failed
}

enum payment_method {
  cashfree
}

enum auction_type {
  live
  timed
}

enum product_type {
  electronics
  fashion
  automobiles
  real_estate
  art
  collectibles
  home_appliances
  sports
  others
}

enum auction_status {
  upcoming
  ongoing
  completed
  cancelled
}